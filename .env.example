# Скопируйте в .env и правьте под себя. Все значения опциональны:
# без .env система полностью работает на моке.

# --- порты на хосте ---
GATEWAY_PORT=8080
MOCK_PORT=8081
POSTGRES_PORT=5432
OLLAMA_PORT=11434

LOG_LEVEL=INFO
# text — для человека, json — по строке-объекту на запись, для сборщика логов
LOG_FORMAT=text

# --- лимит на входе: local (по процессу) или shared (общий счётчик в Postgres) ---
# RATE_LIMIT_SCOPE=shared

# --- сценарий отказов, с которым стартует мок ---
MOCK_SCENARIO=healthy

# --- оверлей конфигурации (итерации надёжности) ---
# GATEWAY_CONFIG_OVERLAY=config/iterations/01_baseline.yaml

# --- реальные провайдеры (по умолчанию выключены) ---
# OPENAI_ENABLED=true
# OPENAI_API_KEY=sk-...
# ANTHROPIC_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...

# --- локальная модель: docker compose --profile ollama up ---
# OLLAMA_ENABLED=true
# OLLAMA_MODEL=qwen2.5:0.5b

# --- точечные оверрайды любого поля конфига ---
# GW__RELIABILITY__RETRIES__ENABLED=true
# GW__BUDGET__LIMIT_USD=1.0
